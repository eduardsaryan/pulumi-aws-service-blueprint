{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm install)",
      "Bash(npm install --prefix policy)",
      "Bash(pulumi preview:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(pulumi up:*)",
      "Bash(pulumi destroy:*)",
      "Bash(pulumi refresh:*)",
      "Bash(pulumi import:*)",
      "Bash(pulumi state:*)",
      "Bash(pulumi stack rm:*)",
      "Bash(pulumi config set:*)",
      "Bash(npm run up:*)",
      "Bash(npm run destroy:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./Pulumi.*.yaml)",
      "Edit(./policy/**)",
      "Edit(./.github/workflows/**)"
    ]
  }
}
